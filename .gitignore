# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (the .example templates are committed)
.env*
!.env*.example

# vercel
.vercel

# python
python-api/.venv
python-api/__pycache__
python-api/**/__pycache__

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright MCP session logs and traces
.playwright-mcp/
.claude/

docs/
# Local Supabase: data copied from the cloud project (large, contains live data)
supabase/seed.sql
supabase/backups/

# Backtest notebook export (derived from the local database, re-made by the notebook's last cell)
python-api/backtest/output/

# Jupyter autosaves
.ipynb_checkpoints/

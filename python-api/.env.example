# Direct Postgres connection. The service reads and writes everything through
# it: ingest bulk-loads `raw`, warehouse.refresh() rebuilds the layers, and the
# optimiser reads prices and the snapshot cache. It needs a role that can do
# that, so it is the service's alone: never set it on Vercel.
# Defaults to the local Supabase database when unset. In production, the
# project's connection string (Dashboard -> Connect), session pooler.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Comma-separated origins allowed to call this service.
ALLOWED_ORIGINS=http://localhost:3000

# Required to call POST /backfill/*. Unset closes those routes entirely rather
# than opening them: an ingest that pins the CPU for ten minutes is not a
# sensible default for an unauthenticated endpoint. Cloud Scheduler sends it as
# X-Backfill-Token.
BACKFILL_TOKEN=

# When set, POST /efficient-frontier requires a matching X-Margin-Origin header,
# which only the dashboard's own route handler sends. Leave blank locally, where
# the solver is reached directly by the sweep script.
MARGIN_ORIGIN_SECRET=

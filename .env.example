# Base URL of the running market-data service (see api/README.md).
MARKET_DATA_API_URL=http://127.0.0.1:8000

# Supabase project URL and PUBLISHABLE (anon) key.
# Read-only, and row-level security limits it to the two snapshot tables — see
# supabase/migrations/20260904000000_deploy_readiness.sql. This is what lets the
# screener and the stock pages render with the solver scaled to zero.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
supabase_password=

# Set to "true" to expose /data and the backfill routes behind it. There are no
# user accounts, so this stays unset in production and the scheduled refreshes
# call the service directly instead.
ENABLE_DATA_PAGE=

# Forwarded as X-Backfill-Token by the /data proxy routes. Only needed when
# ENABLE_DATA_PAGE is on; must match the value in api/.env.
BACKFILL_TOKEN=

# Sent as X-Margin-Origin on every solve, proving the request came through this
# app rather than from something pointed at the service URL. Leave blank for
# local development; must match MARGIN_ORIGIN_SECRET in the service.
MARGIN_ORIGIN_SECRET=

# Per-caller ceilings on POST /api/efficient-frontier. Defaults are 10 and 60;
# raise them to run the optimiser sweep without tripping the limiter.
RATE_LIMIT_SOLVES_PER_MINUTE=
RATE_LIMIT_SOLVES_PER_HOUR=

# Supabase project URL and SERVICE ROLE key.
# Dashboard -> Project Settings -> API. The service role key bypasses RLS,
# which the bulk backfill writes need. Never expose it to the browser, and
# never set it on Vercel — only this service has any use for it.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated origins allowed to call this service.
ALLOWED_ORIGINS=http://localhost:3000

# Required to call POST /backfill/*. Unset closes those routes entirely rather
# than opening them: an ingest that pins the CPU for ten minutes is not a
# sensible default for an unauthenticated endpoint. Cloud Scheduler sends it as
# X-Backfill-Token.
BACKFILL_TOKEN=

# When set, POST /efficient-frontier requires a matching X-Margin-Origin header,
# which only the dashboard's own route handler sends. Leave blank locally, where
# the solver is reached directly by the sweep script.
MARGIN_ORIGIN_SECRET=
